# Copie este arquivo para ".env" e preencha com os dados reais.
# NUNCA versione o arquivo ".env" (ele já está no .gitignore).

# ---- Empresa 1 ----
EMPRESA1_NOME=
# Se conseguirmos usar a API oficial do Tiny, preencha o token gerado no painel do Tiny:
EMPRESA1_TINY_API_TOKEN=
# Se formos pelo fallback de sessão HTTP (login simulado), preencha usuário/senha:
EMPRESA1_TINY_USER=
EMPRESA1_TINY_PASS=

# ---- Empresa 2 ----
EMPRESA2_NOME=
EMPRESA2_TINY_API_TOKEN=
EMPRESA2_TINY_USER=
EMPRESA2_TINY_PASS=

# ---- Empresa 3 ----
EMPRESA3_NOME=
EMPRESA3_TINY_API_TOKEN=
EMPRESA3_TINY_USER=
EMPRESA3_TINY_PASS=

# Ambiente (development / production)
APP_ENV=development
