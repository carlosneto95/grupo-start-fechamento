# Copie para ".env" e preencha. O .env NUNCA vai para o git (.gitignore e
# hook pre-commit recusam). Todo nome tem o prefixo GSF_ (Grupo Start
# Fechamento): no PythonAnywhere o processo é dividido com outros sistemas,
# e só o que começa com GSF_ é lido — ver financeiro/configuracao.py.

# ---- Obrigatório --------------------------------------------------------
# Chave de assinatura da sessão, 32+ caracteres aleatórios. Sem ela o sistema
# não sobe. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GSF_SECRET_KEY=

# ---- Contas do Tiny (uma por empresa) -----------------------------------
# Token da API v2, gerado no painel do Tiny de cada empresa.
GSF_EMPRESA1_NOME=
GSF_EMPRESA1_TINY_API_TOKEN=

GSF_EMPRESA2_NOME=
GSF_EMPRESA2_TINY_API_TOKEN=

GSF_EMPRESA3_NOME=
GSF_EMPRESA3_TINY_API_TOKEN=

# ---- Opcionais (valor padrão entre parênteses) --------------------------
# Banco SQLite (data/app.db).
GSF_BANCO=
# Pasta dos logs com rotação (logs/).
GSF_LOGS=
# Pasta dos backups automáticos antes de migração (backups/).
GSF_BACKUPS=
# 0 só em desenvolvimento local sem HTTPS (1).
GSF_COOKIE_SEGURO=
# development ou production.
GSF_AMBIENTE=development
